function getOutcome(roll, dieType, isScaled = false) {
    const thresholds = outcomeThresholds[dieType];
    let outcome;

    if (thresholds.triumph.includes(roll)) outcome = 'Triumph';
    else if (thresholds.conflict.includes(roll)) outcome = 'Conflict';
    else outcome = 'Disaster';

    if (isScaled) {
        if (outcome === 'Disaster') {
            if (thresholds.conflict.includes(roll)) return 'Conflict';
            if (thresholds.triumph.includes(roll)) return 'Success';
        }
        if (outcome === 'Conflict' && thresholds.triumph.includes(roll)) {
            return 'Success';
        }
    }

    return outcome;
}

