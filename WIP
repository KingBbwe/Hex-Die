class ChatConfig {
    constructor(name, chatId) {
        this.name = name;
        this.chatId = chatId;
        this.gmCode = generateGMCode();
        this.players = [];
        this.createdAt = Date.now();
    }
}

function generateGMCode() {
    return 'GM_' + Math.random().toString(36).substr(2).toUpperCase();
}

function saveNewChat(name, chatId) {
    const gmCode = generateGMCode();
    const chatConfig = new ChatConfig(name, chatId);
    let chats = JSON.parse(localStorage.getItem(CHAT_STORAGE_KEY) || '{}');
    chats[gmCode] = chatConfig;
    localStorage.setItem(CHAT_STORAGE_KEY, JSON.stringify(chats));
    return gmCode;
}

function getActiveChatId(gmCode) {
    const chats = JSON.parse(localStorage.getItem(CHAT_STORAGE_KEY) || '{}');
    return chats[gmCode]?.chatId || DEFAULT_CHAT_ID;
}

