    switch (messageType) {
        case 'fate':
            telegramMessage = `✨ *Fate Point Added* ✨\nNew total: ${data.points}`;
            break;

        case 'roll':
            telegramMessage =
                `✨ *Harmonized Hex & Die* ✨\n` +
