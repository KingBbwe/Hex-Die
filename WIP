function initializeFatePoints() {
   const storedData = localStorage.getItem(FATE_STORAGE_KEY);
   const now = Date.now();
   
   if (storedData) {
       const { points } = JSON.parse(storedData);
       document.getElementById('fatePoints').value =
           Math.min(points + BASE_FATE_POINTS , MAX_FATE_POINTS);
       updateFateStorage(points);
   } else {
       document.getElementById('fatePoints').value =
           BASE_FATE_POINTS;
       updateFateStorage(BASE_FATE_POINTS);
   }
}

function updateFateStorage(points) {
   const storageData = { points : points || parseInt(document.getElementById('fatePoints').value), timestamp : Date.now() };
