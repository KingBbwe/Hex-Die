                `📊 Total: ${data.total} (DC: ${data.dc})\n` +
                `📜 Outcome: ${data.outcome}\n` +
                `🔮 ${data.narrative.substring(0, 100)}...\n` +
                `▫️▫️▫️▫️▫️▫️▫️▫️▫️\n` +
                `#AuldEwe #FateCast`;
            break;

        case 'legendary':
            telegramMessage = `🌟 *LEGENDARY FEAT* 🌟\n${data.message}`;
            break;

        case 'changingLines':
            telegramMessage =
                `🌀 *Changing Lines Revealed* 🌀\n` +
                `▫️▫️▫️▫️▫️▫️▫️▫️▫️\n` +
