// ======================
// Shake Detection
// ======================
const MIN_SHAKE_DURATION=2000; 
const SHAKE_END_TIMEOUT=500; 
const SHAKE_THRESHOLD=15; 
const SHAKE_COOLDOWN=1000;

function handleShake(event) {
     if(!shakeEnabled)return; 
     const now=Date.now(); 
     const acceleration=event.accelerationIncludingGravity; 
     if(isShaking){ 
         if(Math.abs(acceleration.x)>SHAKE_THRESHOLD||Math.abs(acceleration.y)>SHAKE_THRESHOLD||Math.abs(acceleration.z)>SHAKE_THRESHOLD){ 
             lastShakeTime=now; 
         }else if(now-lastShakeTime>SHAKE_END_TIMEOUT){ 
             isShaking=false; 
         } 
     }else{ 
         if(Math.abs(acceleration.x)>SHAKE_THRESHOLD||Math.abs(acceleration.y)>SHAKE_THRESHOLD||Math.abs(acceleration.z)>SHAKE_THRESHOLD){ 
             shakeStartTime=now; 
             isShaking=true; 
         } 
     } 
}

